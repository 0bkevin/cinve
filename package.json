{
  "name": "cinev-mcp",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "MCP de consulta de cartelera, funciones y precios de cines venezolanos",
  "homepage": "https://cinve.kevinbravo.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0bkevin/cinve.git"
  },
  "bugs": {
    "url": "https://github.com/0bkevin/cinve/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "cinev-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "npm run build:client && tsc && mkdir -p dist/assets && cp -R src/assets/. dist/assets/",
    "start": "node dist/index.js",
    "predev": "npm run build:client",
    "dev": "tsx src/index.ts",
    "pretest": "npm run build:client",
    "test": "tsx scripts/test-postgres.ts",
    "check": "tsc -p tsconfig.check.json && tsc -p tsconfig.client.json --noEmit",
    "presmoke": "npm run build:client",
    "smoke": "tsx scripts/smoke.ts",
    "login": "tsx src/auth-cli.ts login",
    "logout": "tsx src/auth-cli.ts logout",
    "auth:status": "tsx src/auth-cli.ts status",
    "start:hosted": "node dist/hosted-main.js",
    "hosted:admin": "node dist/hosted-admin.js",
    "start:remote": "node dist/remote-main.js",
    "db:migrate": "tsx src/hosted-admin.ts migrate",
    "db:cleanup": "tsx src/hosted-admin.ts cleanup",
    "build:hosted": "npm run build:client && tsc -p tsconfig.hosted.json && cp .hosted/server.js .hosted/index.js && mkdir -p .hosted/src/assets && cp -R src/assets/. .hosted/src/assets/",
    "test:codex-auth": "npm run build && node scripts/verify-codex-auth.mjs",
    "build:client": "tsc -p tsconfig.client.json"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "cheerio": "^1.2.0",
    "pg": "^8.23.1",
    "tough-cookie": "^6.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@neondatabase/serverless": "^1.1.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "basecoat-css": "1.1.0",
    "simple-icons": "16.35.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
