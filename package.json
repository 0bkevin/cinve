{
  "name": "cinev-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP de consulta de cartelera, funciones y precios de cines venezolanos",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "cinev-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && mkdir -p dist/assets && cp src/assets/* dist/assets/",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "tsx scripts/test-postgres.ts",
    "check": "tsc -p tsconfig.check.json",
    "smoke": "tsx scripts/smoke.ts",
    "login": "tsx src/auth-cli.ts login",
    "logout": "tsx src/auth-cli.ts logout",
    "auth:status": "tsx src/auth-cli.ts status",
    "start:hosted": "node dist/hosted-main.js",
    "hosted:admin": "node dist/hosted-admin.js",
    "start:remote": "node dist/remote-main.js",
    "db:migrate": "tsx src/hosted-admin.ts migrate",
    "db:cleanup": "tsx src/hosted-admin.ts cleanup",
    "build:hosted": "tsc -p tsconfig.hosted.json && cp .hosted/server.js .hosted/index.js && mkdir -p .hosted/src/assets && cp src/assets/* .hosted/src/assets/",
    "test:codex-auth": "npm run build && node scripts/verify-codex-auth.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "cheerio": "^1.2.0",
    "pg": "^8.23.0",
    "tough-cookie": "^6.0.2",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@types/node": "^22.20.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
